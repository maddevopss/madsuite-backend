# MADSuite Backend — Environment de test, exemple
# Ne jamais commiter de fichier .env réel. Copier en .env.test et adapter.
#
# Constat Étage 7 PR E (#175) : POSTGRES_ADMIN_URL n'était documenté nulle
# part en dehors des workflows CI (.github/workflows/*.yml). Son absence en
# local fait échouer silencieusement src/test/migrations.integration.test.js
# et src/test/migrations.065.integration.test.js (la base de migration
# dédiée n'est jamais créée) — pas un bug applicatif, un trou de
# documentation qui coûte du temps de diagnostic à chaque nouvel
# environnement de développement.

NODE_ENV=test

# Base de test principale (utilisée par la majorité des suites)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madsuite_test
TEST_DB_NAME=madsuite_test

# Connexion admin (superuser) requise UNIQUEMENT par
# migrations.integration.test.js pour DROP/CREATE une base de migration
# dédiée (MIGRATION_TEST_DB_NAME, défaut madsuite_migrations_test) et y
# valider les migrations depuis zéro. Doit pointer sur la base "postgres"
# (ou toute base où le rôle a le droit CREATEDB), jamais sur une base
# applicative.
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optionnel — nom de la base de migration dédiée, doit se terminer par
# "_test" (assertSafeTestDatabase refuse sinon de s'exécuter).
# MIGRATION_TEST_DB_NAME=madsuite_migrations_test
