FROM node:22-bookworm-slim AS dependencies

WORKDIR /app

COPY package*.json ./
# Le postinstall Prisma est ignore: le depot ne contient aucun schema Prisma.
# Le lockfile actuel contient aussi un conflit de peer dependency ESLint historique.
RUN npm ci --include=dev --legacy-peer-deps --ignore-scripts \
  && npm prune --omit=dev --legacy-peer-deps --ignore-scripts

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

EXPOSE 5000

CMD ["node", "server.js"]
